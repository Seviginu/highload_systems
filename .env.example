POSTGRES_DB=vs_lab1
POSTGRES_USER=vs_lab1
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

USER_DB_USERNAME=users
USER_DB_PASSWORD=change-me
USER_SERVICE_PORT=8082

REDIS_PORT=6379
TASK_CACHE_TTL=10m

PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=AdminPassword123!
REDISINSIGHT_PORT=5540

SERVER_PORT=8080
GATEWAY_PORT=8081
CONFIG_SERVER_PORT=8888
EUREKA_SERVER_PORT=8761

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NAME=Supervisor
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

JWT_KEY_DIR=./.local/jwt
JWT_ISSUER=http://task-tracker
JWT_AUDIENCE=task-tracker-api
JWT_TTL_SECONDS=900
STARTUP_TIMEOUT_SECONDS=180

# Keep the cluster ID unchanged while Kafka volumes are retained.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_UI_PORT=8083
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9094,kafka-3:9096

NOTIFICATION_DB_USERNAME=notifications
NOTIFICATION_DB_PASSWORD=change-me

FILE_DB_USERNAME=files
FILE_DB_PASSWORD=change-me
FILE_MAX_BYTES=10485760

# Local S3 (MinIO); file-service creates the bucket on startup.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
FILE_S3_REGION=us-east-1
FILE_S3_BUCKET=files
# For running file-service outside Docker:
FILE_S3_ENDPOINT=http://localhost:9000
FILE_S3_ACCESS_KEY=minioadmin
FILE_S3_SECRET_KEY=minioadmin123
